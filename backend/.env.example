# OrbitalGuard AI Backend Configuration

# Database Connection (PostgreSQL for production; SQLite fallback supported)
DATABASE_URL=postgresql+psycopg://orbitaluser:orbitalpass@localhost:5432/orbitalguard

# CelesTrak Orbital Data Ingestion (Adheres to CelesTrak Usage Policy: 2h cycle, no rapid polling)
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
CELESTRAK_GROUPS=stations,active,starlink,cosmos-2251-debris,fengyun-1c-debris
DATA_REFRESH_INTERVAL_HOURS=2.0
CELESTRAK_TIMEOUT_SECONDS=15
CELESTRAK_MAX_RETRIES=3

# Admin Security Key (required for manual refresh and admin telemetry endpoints)
ADMIN_API_KEY=orbitalguard-admin-secret-key

# Decision-Support Screening Horizon & Physics Parameters
DEFAULT_SCREENING_THRESHOLD_KM=25.0
CRITICAL_RISK_THRESHOLD_KM=2.0
HIGH_RISK_THRESHOLD_KM=5.0
MEDIUM_RISK_THRESHOLD_KM=12.0
DEFAULT_SCREENING_WINDOW_HOURS=48.0
SCREENING_TIME_STEP_SECONDS=300

# Operational Prototype Flags
ENABLE_FALLBACK_DEMO_DATA=true
LOG_LEVEL=INFO
DEBUG=false
